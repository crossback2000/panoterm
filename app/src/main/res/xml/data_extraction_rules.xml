<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the phone through Android backup or device-to-device transfer.
  allowBackup="false" alone stops only cloud backup on Android 12+; a device transfer
  (Smart Switch, Google setup) would still copy filesDir, including the Tailscale node's
  private key (tsnet state) — a second phone would then run as the same tailnet node.
  SSH keys would arrive unusable anyway (their Keystore key stays on the old phone).
  Moving to a new phone: Settings → 백업 (password-encrypted export).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
